{
  "name": "docker-ip-whitelist",
  "version": "1.0.0",
  "description": "Manage IP whitelists for Docker-published ports through the DOCKER-USER chain: CIDR math, idempotent iptables planning, dry-run, drift detection, rollback. Zero dependencies.",
  "type": "module",
  "license": "MIT",
  "author": "Retsumdk",
  "keywords": [
    "docker",
    "iptables",
    "firewall",
    "whitelist",
    "cidr",
    "network-security",
    "devops"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "diw": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18.17"
  },
  "scripts": {
    "prepare": "tsc",
    "build": "tsc",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "typecheck:tests": "tsc -p tsconfig.test.json --noEmit",
    "demo": "node dist/cli.js demo"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "bun-types": "^1.4.3",
    "typescript": "^5.5.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Retsumdk/docker-ip-whitelist.git"
  },
  "bugs": {
    "url": "https://github.com/Retsumdk/docker-ip-whitelist/issues"
  },
  "homepage": "https://github.com/Retsumdk/docker-ip-whitelist#readme"
}
